# Copy this file to `server/.env` and fill in the key. Never commit `.env`.

# UniSound MaaS key. Server-side only; the browser never receives it.
UNISOUND_API_KEY=

# Where the service listens. Keep 127.0.0.1 behind Nginx; use 0.0.0.0 only
# when the process itself must be reachable from outside the machine.
# HOST=0.0.0.0
# PORT=8787

# Comma-separated browser origins allowed to call the API. Empty means any
# origin. Set this once the workbench has a stable URL.
# QUILL_ALLOWED_ORIGINS=https://your-domain.example

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1

# Private beta gate. When set, /api/resume/extract requires the same code in
# the `X-Quill-Beta` header. Comma-separated values allow several codes.
# QUILL_BETA_CODE=quill-beta-example

# Global extraction cap per UTC day; 0 disables it.
# QUILL_DAILY_LIMIT=200

# QUILL_MAX_UPLOAD_MB=24
# QUILL_OCR_MAX_PAGES=4
# QUILL_REQUEST_TIMEOUT_MS=180000
# QUILL_RATE_LIMIT=20
# QUILL_MAX_CONCURRENT=3
